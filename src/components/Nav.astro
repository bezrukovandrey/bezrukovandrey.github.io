---
import ThemeToggle from "./ThemeToggle.astro";

interface NavLink {
  label: string;
  href: string;
}

const rawLinks: NavLink[] = [
  { label: "Home", href: "/" },
  { label: "Experience", href: "/experience" },
  { label: "Education", href: "/education" },
  { label: "Projects", href: "/projects" },
  { label: "Volunteering", href: "/volunteering" },
  { label: "CV", href: "/cv" },
  { label: "Contact", href: "/contact" },
];

const current = Astro.url.pathname;

const links = rawLinks.map((link) => ({
  ...link,
  active:
    current === link.href ||
    (link.href !== "/" && current.startsWith(link.href)),
}));
---
<header class="mb-12">
  <div class="flex items-start justify-between gap-5">
    <div class="flex items-start gap-5">
      <img
        src="/profile.jpg"
        alt="Portrait of me"
        class="h-30 w-30 shrink-0 rounded-sm object-cover"
      />
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Andrei Bezrukov</h1>
        <p class="mt-1 font-mono text-sm text-muted">
          MSc / M2 Artificial Intelligence (Applied track) - Université Grenoble Alpes / Grenoble INP Ensimag
        </p>
	<a
          href="mailto:bezrukov.andrey.work@gmail.com"
          class="mt-2 inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4">
            <rect x="3" y="5" width="18" height="14" rx="1.5" />
            <path d="m4 6.5 8 6 8-6" />
          </svg>
          bezrukov.andrey.work@gmail.com
        </a>
        <a
          href="mailto:andrei.bezrukov@etu.univgrenoble-alpes.fr"
          class="mt-2 inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4">
            <rect x="3" y="5" width="18" height="14" rx="1.5" />
            <path d="m4 6.5 8 6 8-6" />
          </svg>
          andrei.bezrukov@etu.univgrenoble-alpes.fr
        </a>
      </div>
    </div>

    <ThemeToggle />
  </div>

  <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
    {links.map((link) => <a href={link.href} class:list={["border-b pb-0.5 transition-colors", link.active ? "border-accent text-paper" : "border-transparent text-muted hover:border-muted hover:text-paper"]}>{link.label}</a>)}
  </nav>
  <div class="mt-8 border-t border-panel"></div>
</header>
