---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { education } from "../data/education";
---
<Layout title="Education">
  <Nav />
  <main>
    <section>
      <h2 class="font-mono text-sm text-muted">Education</h2>
      <p>My academic background combines computer science, software development and artificial intelligence. Over time, my interests have expanded from building applications towards understanding the algorithms, computational methods and human factors behind technology.</p>
      <div class="mt-6 divide-y divide-panel border-t border-panel">
        {education.map((entry) => (
          <div class="py-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-semibold text-paper">{entry.title}</h3>
              <span class="font-mono text-xs text-muted">{entry.period}</span>
            </div>
            <p class="mt-1 text-sm text-muted">{entry.institution}</p>
            <p class="mt-2 leading-relaxed text-paper/90">{entry.description}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
