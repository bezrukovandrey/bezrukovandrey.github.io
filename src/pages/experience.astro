---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { experience } from "../data/experience";
---
<Layout title="Experience">
  <Nav />
  <main>
    <section>
      <h2 class="font-mono text-sm text-muted">Professional Experience</h2>
      <p>My experience combines applied AI research with hands-on work in software engineering and technical support. Across these roles, I've investigated technical problems, built and evaluated experimental solutions, and worked with engineering teams to understand how software behaves in practice.</p>
      <div class="mt-6 divide-y divide-panel border-t border-panel">
        {experience.map((entry) => (
          <article class="py-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-semibold text-paper">{entry.title}</h3>
              <span class="font-mono text-xs text-muted">{entry.period}</span>
            </div>

            {(entry.address || entry.link || entry.relatedWork) && (
              <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-muted">
                {entry.address && <span>{entry.address}</span>}
                {entry.link && (
                  <a
                    href={entry.link}
                    target="_blank"
                    rel="noreferrer"
                    class="text-paper underline decoration-panel underline-offset-4 hover:decoration-accent"
                  >
                    Organization website ↗
                  </a>
                )}
                {entry.relatedWork && (
                  <a
                    href={entry.relatedWork}
                    target="_blank"
                    rel="noreferrer"
                    class="text-paper underline decoration-panel underline-offset-4 hover:decoration-accent"
                  >
                    Related work ↗
                  </a>
                )}
              </div>
            )}

            {entry.summary && (
              <p class="mt-2 leading-relaxed text-paper/90">{entry.summary}</p>
            )}

            {entry.groups && (
              <div class="mt-3 space-y-4">
                {entry.groups.map((group) => (
                  <div>
                
                    <ul class="mt-1 list-disc space-y-1 pl-5 text-sm leading-relaxed text-muted">
                      {group.bullets.map((bullet) => <li>{bullet}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>